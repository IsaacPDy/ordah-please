{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "tests/e2e/**/*.ts",
    "vitest.config.ts"
  ]
}
