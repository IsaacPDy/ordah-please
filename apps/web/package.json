{
  "name": "@ordah-please/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:dependencies": "npm run build --workspace @ordah-please/domain && npm run build --workspace @ordah-please/contracts && npm run build --workspace @ordah-please/db && npm run build --workspace @ordah-please/ui",
    "dev": "next dev",
    "lint": "eslint .",
    "prebuild": "npm run build:dependencies",
    "predev": "npm run build:dependencies",
    "pretypecheck": "npm run build:dependencies",
    "start": "next start",
    "test": "vitest run --config ../../vitest.config.ts --project server",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.12.0",
    "@clerk/nextjs": "^7.5.22",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@ordah-please/contracts": "^0.1.0",
    "@ordah-please/db": "^0.1.0",
    "@ordah-please/domain": "^0.1.0",
    "@ordah-please/ui": "0.1.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-config-next": "16.2.10",
    "standardwebhooks": "^1.0.0",
    "typescript": "5.9.3"
  }
}
